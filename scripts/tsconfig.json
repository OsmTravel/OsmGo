{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "sourceMap": false,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": false,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "es2017",
    "module": "CommonJS",
    "lib": ["ES2017"],
    "types": ["node"],
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@osmgo/*": ["../src/*"]
    }
  },
  "include": ["./*.ts"],
  "exclude": []
}
