{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{ts,js,mjs,cjs,json,jsonc,css}",
      "!!**/node_modules",
      "!!**/dist",
      "!!www",
      "!!coverage",
      "!!.angular",
      "!!playwright-report",
      "!!test-results",
      "!!android",
      "!!src/assets/**/*.json",
      "!!src/assets/osmToOsmgo.min.js",
      "!!scripts/osmToOsmgo/index.min.js",
      "!!scripts/osmToOsmgo/fixture/**/*.json",
      "!!scripts/osmToOsmgo/package-lock.json",
      "!!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noInnerDeclarations": "off",
        "noSelfAssign": "off",
        "noVoidTypeReturn": "off"
      },
      "style": {
        "useImportType": "off"
      },
      "suspicious": {
        "noDoubleEquals": "off",
        "noDuplicateTestHooks": "off",
        "noExportsInTest": "off",
        "noImplicitAnyLet": "off",
        "noShadowRestrictedNames": "off",
        "noUnsafeNegation": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
